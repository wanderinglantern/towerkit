{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://towerkit.dev/schema/program.schema.json",
  "title": "Insurance program placement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "insured",
    "program",
    "placement",
    "period",
    "lines",
    "layers",
    "retentions",
    "sublimits"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "insured": {
      "type": "string",
      "minLength": 1
    },
    "program": {
      "type": "string",
      "minLength": 1
    },
    "placement": {
      "enum": [
        "bound",
        "proposed"
      ]
    },
    "period": {
      "$ref": "#/$defs/period"
    },
    "currency": {
      "type": "string",
      "minLength": 3,
      "maxLength": 3
    },
    "render": {
      "description": "Saved chart options so renders don't need re-selecting.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "theme": {
          "type": "string",
          "minLength": 1
        },
        "showTotals": {
          "type": "boolean"
        },
        "showPremiums": {
          "type": "boolean"
        },
        "cellPremiums": {
          "type": "boolean"
        },
        "cellDates": {
          "type": "boolean"
        },
        "soiSchematic": {
          "type": "boolean"
        }
      }
    },
    "lines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/line"
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/layer"
      }
    },
    "retentions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/retention"
      }
    },
    "sublimits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sublimit"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "money": {
      "description": "Integer whole dollars. Never a float.",
      "type": "integer",
      "minimum": 0
    },
    "share": {
      "description": "Decimal fraction of a layer, precise to the basis point (0.0001).",
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "abbr": {
          "type": "string",
          "minLength": 1
        },
        "group": {
          "description": "Optional bucket label (project, location, entity); adjacent lines sharing a group render flush with a band beneath.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "appliesTo",
        "attach",
        "limit"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "policyNumber": {
          "description": "Policy number of the issued policy behind this layer.",
          "type": "string",
          "minLength": 1
        },
        "period": {
          "description": "Policy effective/expiry when it differs from the program period.",
          "$ref": "#/$defs/period"
        },
        "followsUnderlying": {
          "description": "The layer's bottom edge follows the top of each column's underlying stack (stepped attachment, flat top).",
          "type": "boolean"
        },
        "appliesTo": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "attach": {
          "$ref": "#/$defs/money"
        },
        "limit": {
          "description": "Integer dollars. Positivity is a semantic rule so drafts stay loadable.",
          "type": "integer"
        },
        "namedLimits": {
          "description": "Several coordinate limits where limit states one, in display order. Peers, not sublimits. Composes the SOI Limits column when limitsDetail is absent.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/namedLimit"
          }
        },
        "statutory": {
          "description": "Coverage with no dollar limit (WC statutory). limit must be 0; excluded from limit totals.",
          "type": "boolean"
        },
        "states": {
          "description": "Jurisdictions a statutory layer covers, in display order. Statutory layers only; monopolistic-fund states are refused. Semantic rules so drafts stay loadable.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "premium": {
          "$ref": "#/$defs/money"
        },
        "limitsDetail": {
          "description": "SOI Limits column prose for THIS LAYER'S limit, exported verbatim; composed from limit/attach when absent. Sublimits are scoped to lines, not layers, so they are appended to the cell either way and this never replaces them.",
          "type": "string",
          "minLength": 1
        },
        "retentionDetail": {
          "description": "SOI Deductible/SIR/Retention column prose, exported verbatim; composed from retentions when absent.",
          "type": "string",
          "minLength": 1
        },
        "premiumDetail": {
          "description": "SOI Premium cell text, exported verbatim in place of \"Included\", for a premium of 0 only. Says what the layer is priced with.",
          "type": "string",
          "minLength": 1
        },
        "participants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/participant"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "namedLimit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "amount"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "amount": {
          "$ref": "#/$defs/money"
        }
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "carrier",
        "share"
      ],
      "properties": {
        "carrier": {
          "type": "string",
          "minLength": 1
        },
        "share": {
          "$ref": "#/$defs/share"
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appliesTo",
        "type",
        "amount"
      ],
      "properties": {
        "appliesTo": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "type": {
          "enum": [
            "deductible",
            "sir",
            "captive"
          ]
        },
        "amount": {
          "$ref": "#/$defs/money"
        },
        "aggregate": {
          "$ref": "#/$defs/money"
        },
        "vehicle": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "sublimit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "amount",
        "appliesTo"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "amount": {
          "$ref": "#/$defs/money"
        },
        "appliesTo": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}
